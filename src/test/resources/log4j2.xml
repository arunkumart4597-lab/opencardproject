<Configuration status="WARN">
    <Properties>
        <Property name="basepath">./logs</Property>
    </Properties>
    <Appenders>
        <!-- Console (Eclipse) -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} %-5level %c{1} - %msg%n"/>
        </Console>
        <!-- Rolling log file (existing one, with Policies wrapper and bigger size) -->
        <RollingFile name="RollingFile"
                     fileName="${basepath}/automation.log"
                     filePattern="${basepath}/automation-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
        <!-- OPTIONAL: errors only -->
        <File name="ErrorFile" fileName="${basepath}/errors.log">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %c{1} - %msg%n"/>
            <ThresholdFilter level="error" onMatch="ACCEPT" onMismatch="DENY"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="TestFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>
</Configuration>
